{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"border": {
			"radius": false
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#18181b",
					"name": "墨色"
				},
				{
					"slug": "paper",
					"color": "#faf9fc",
					"name": "纸面"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "表面"
				},
				{
					"slug": "muted",
					"color": "#52525b",
					"name": "次要文字"
				},
				{
					"slug": "line",
					"color": "#efedf5",
					"name": "分隔线"
				},
				{
					"slug": "accent",
					"color": "#7c3aed",
					"name": "主题紫"
				},
				{
					"slug": "accent-dark",
					"color": "#4c1d95",
					"name": "深紫"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "720px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw", "vh"],
			"spacingSizes": [
				{
					"name": "小",
					"slug": "30",
					"size": "0.75rem"
				},
				{
					"name": "中",
					"slug": "40",
					"size": "1.25rem"
				},
				{
					"name": "大",
					"slug": "50",
					"size": "2rem"
				},
				{
					"name": "特大",
					"slug": "60",
					"size": "3rem"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Noto Sans CJK SC\", \"Microsoft YaHei\", sans-serif",
					"slug": "sans",
					"name": "无衬线"
				},
				{
					"fontFamily": "\"SF Mono\", ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
					"slug": "mono",
					"name": "等宽"
				}
			],
			"fontSizes": [
				{
					"name": "小号",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "正文",
					"slug": "normal",
					"size": "1rem"
				},
				{
					"name": "大号",
					"slug": "large",
					"size": "1.25rem"
				},
				{
					"name": "特大号",
					"slug": "x-large",
					"size": "1.25rem"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "0.875rem",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "1.25rem",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"bottom": "1.25rem"
					}
				}
			},
			"core/heading": {
				"spacing": {
					"margin": {
						"top": "2rem",
						"bottom": "0.75rem"
					}
				}
			}
		}
	}
}
